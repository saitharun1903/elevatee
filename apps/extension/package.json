{
  "name": "@elevate/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elevate browser extension (Chrome & Edge, Manifest V3).",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "build:dev": "node scripts/build.ts --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "node scripts/build.ts && node scripts/zip.ts",
    "dev-key": "node scripts/dev-key.ts"
  },
  "dependencies": {
    "@elevate/core": "*"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
