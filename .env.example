# =============================================================================
# Elevate — environment configuration
# Copy to apps/web/.env.local for local development. Never commit real values.
# Every provider is optional; when one is missing Elevate shows exactly which
# variables are required instead of faking results.
# =============================================================================

# --- Application URLs --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database + auth) — REQUIRED -----------------------------------
# Local: `npx supabase start` prints these. Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "true" only if Google OAuth is enabled in Supabase Auth providers.
NEXT_PUBLIC_AUTH_GOOGLE=false
# The service-role key is NOT used by the app. It is only needed to run the
# RLS integration tests (apps/web/tests/rls.test.ts) against a test project.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=

# --- AI provider (job intelligence, resume parsing, comparison, plans, mock interviews)
# The first configured provider wins; override with AI_PROVIDER_ORDER=openrouter,gemini
GEMINI_API_KEY=
# Ordered fallback list; overloaded or retired models are skipped automatically.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Any OpenAI-compatible chat-completions endpoint:
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=
AI_PROVIDER_ORDER=

# --- Research provider (company, process, interview evidence) -----------------
# The first configured provider wins; override with RESEARCH_PROVIDER_ORDER.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
RESEARCH_PROVIDER_ORDER=
# Context.dev is not integrated yet: there is no adapter, so setting a key has no effect.

# --- Cloudflare R2 (private storage for original resume files) -----------------
# Without R2, extracted resume text is still stored; original files are not.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sentry (error monitoring) -------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Browser extension ---------------------------------------------------------
# Comma-separated Chrome/Edge extension IDs allowed to call the API (CORS) and
# to receive the session on /extension/connect.
NEXT_PUBLIC_EXTENSION_IDS=
NEXT_PUBLIC_EXTENSION_STORE_URL=
NEXT_PUBLIC_EDGE_ADDONS_URL=
# Build-time variables for apps/extension:
# ELEVATE_APP_URL=http://localhost:3000
# EXTENSION_PUBLIC_KEY=      (pins the extension ID for local development)
# ELEVATE_SENTRY_DSN=

# --- Admin / diagnostics ------------------------------------------------------
# Comma-separated emails allowed to open /diagnostics in production.
ADMIN_EMAILS=
# Development only: open diagnostics to any signed-in user (ignored in production).
DIAGNOSTICS_OPEN=false
